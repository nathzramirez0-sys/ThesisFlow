<?xml version="1.0" encoding="utf-8"?>
<!-- The local build's changes to src/main/AndroidManifest.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
            Firebase never starts in the local build. Its libraries are still in the APK,
            but without this provider nothing can use them by accident: any call would
            fail at once instead of quietly reaching for a server.
        -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
    </application>
</manifest>
