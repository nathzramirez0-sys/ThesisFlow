rules_version = '2';

// Access model: a user reads and writes only their own profile, and only data
// under groups whose `memberIds` include them. Writes that clients must never
// make directly (joining, invite codes, deleting a group) go through Cloud
// Functions, which use the Admin SDK and bypass these rules.
//
// Field limits match domain/validation/Validators.kt.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isMember(groupId) {
      return signedIn() && request.auth.uid in get(groupPath(groupId)).data.memberIds;
    }

    function roleIn(groupId) {
      return get(groupPath(groupId)).data.roles.get(request.auth.uid, null);
    }

    function isLeader(groupId) {
      return signedIn() && roleIn(groupId) == 'leader';
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isOptionalText(value, max) {
      return value == null || isText(value, 0, max);
    }

    function isOptionalTimestamp(value) {
      return value == null || value is timestamp;
    }

    // ---------------------------------------------------------------- users

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && validNewUser();
      allow update: if isSelf(uid) && validUserUpdate();
      allow delete: if false;

      function validUserFields(data) {
        return isText(data.displayName, 0, 50)
          && isText(data.course, 0, 80)
          && isText(data.school, 0, 100)
          && isOptionalText(data.photoUrl, 2048)
          && data.onboardingComplete is bool;
      }

      function validNewUser() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'email', 'displayName', 'photoUrl', 'course', 'school',
            'onboardingComplete', 'createdAt', 'updatedAt'])
          && data.email == request.auth.token.get('email', '')
          && validUserFields(data)
          && data.createdAt == request.time
          && data.updatedAt == request.time;
      }

      // Email and createdAt can't change; finishing onboarding needs a real profile.
      function validUserUpdate() {
        let data = request.resource.data;
        return data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'photoUrl', 'course', 'school', 'onboardingComplete', 'updatedAt'])
          && validUserFields(data)
          && data.updatedAt == request.time
          && (data.onboardingComplete == false
            || (data.displayName.size() >= 2 && data.course.size() >= 1 && data.school.size() >= 1));
      }
    }

    // --------------------------------------------------------------- groups

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && validNewGroup();
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds && validGroupUpdate();
      // Deleting a group must also delete its subcollections: the deleteGroup function does that.
      allow delete: if false;

      // Every member has exactly one known role, and there is always at least one leader.
      function validGroupFields(data) {
        return isText(data.name, 3, 60)
          && isText(data.thesisTitle, 0, 200)
          && isText(data.course, 1, 80)
          && isText(data.school, 1, 100)
          && isOptionalTimestamp(data.proposalDefenseAt)
          && isOptionalTimestamp(data.finalDefenseAt)
          && data.memberIds is list
          && data.roles is map
          && data.roles.keys().hasOnly(data.memberIds)
          && data.memberIds.hasOnly(data.roles.keys())
          && data.roles.values().hasOnly(['leader', 'member', 'adviser'])
          && data.roles.values().hasAny(['leader']);
      }

      // The creator is the only member, and is the leader.
      function validNewGroup() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'name', 'thesisTitle', 'course', 'school', 'memberIds', 'roles',
            'createdBy', 'createdAt', 'updatedAt', 'proposalDefenseAt', 'finalDefenseAt'])
          && validGroupFields(data)
          && data.createdBy == request.auth.uid
          && data.memberIds == [request.auth.uid]
          && data.roles[request.auth.uid] == 'leader'
          && data.createdAt == request.time
          && data.updatedAt == request.time;
      }

      function validGroupUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        return validGroupFields(after)
          && after.updatedAt == request.time
          && (leaderEdit(before, after, changed) || selfLeave(before, after, changed));
      }

      // Leaders edit details and roles, and may remove members. They can't add
      // anyone: new members only arrive through the joinGroup function.
      function leaderEdit(before, after, changed) {
        return before.roles[request.auth.uid] == 'leader'
          && changed.hasOnly([
              'name', 'thesisTitle', 'course', 'school', 'roles', 'memberIds',
              'updatedAt', 'proposalDefenseAt', 'finalDefenseAt'])
          && before.memberIds.hasAll(after.memberIds);
      }

      // Anyone may remove themselves, touching nothing else.
      function selfLeave(before, after, changed) {
        let me = [request.auth.uid].toSet();
        return changed.hasOnly(['memberIds', 'roles', 'updatedAt'])
          && after.memberIds.toSet() == before.memberIds.toSet().difference(me)
          && before.roles.diff(after.roles).affectedKeys() == me;
      }

      // Display copies of each member's name and photo, plus their role.
      match /members/{memberId} {
        allow read: if isMember(groupId);

        // Only the creator's own entry, written in the same batch that creates the group.
        allow create: if isSelf(memberId)
          && !exists(groupPath(groupId))
          && getAfter(groupPath(groupId)).data.createdBy == request.auth.uid
          && request.resource.data.keys().hasOnly(['displayName', 'photoUrl', 'role', 'joinedAt'])
          && request.resource.data.role == 'leader'
          && isText(request.resource.data.displayName, 0, 50)
          && isOptionalText(request.resource.data.photoUrl, 2048)
          && request.resource.data.joinedAt == request.time;

        // A role change must match the group's roles map in the same batch.
        allow update: if isLeader(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role == getAfter(groupPath(groupId)).data.roles[memberId];

        // Removed or leaving: the entry goes together with the memberIds change.
        allow delete: if (isLeader(groupId) || isSelf(memberId))
          && !(memberId in getAfter(groupPath(groupId)).data.memberIds);
      }

      // ------------------------------------------------------------- chapters

      match /chapters/{chapterId} {
        allow read: if isMember(groupId);

        // Leaders add chapters. getAfter also covers the batch that creates the
        // group together with its five default chapters.
        allow create: if signedIn()
          && getAfter(groupPath(groupId)).data.roles.get(request.auth.uid, null) == 'leader'
          && request.resource.data.keys().hasOnly([
              'title', 'order', 'status', 'deadline', 'latestVersion', 'updatedAt', 'updatedBy'])
          && validChapter(request.resource.data)
          && request.resource.data.status == 'not_started'
          && request.resource.data.latestVersion == 0
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if isMember(groupId) && validChapterUpdate(roleIn(groupId));

        // Drafts under a deleted chapter are removed by the cleanUpChapter function.
        allow delete: if isLeader(groupId);

        function validChapter(data) {
          return isText(data.title, 1, 100)
            && data.order is int
            && data.status in ['not_started', 'drafting', 'for_review', 'revisions', 'approved']
            && isOptionalTimestamp(data.deadline)
            && data.latestVersion is int;
        }

        // Who may change which fields (the same table as ChapterRules.kt):
        // - leaders: everything; members: status and new versions; advisers: status.
        // - only leaders and advisers may approve a chapter or undo an approval.
        // - a new version must be exactly one higher, with its version document
        //   written in the same transaction.
        function validChapterUpdate(role) {
          let before = resource.data;
          let after = request.resource.data;
          let changed = after.diff(before).affectedKeys();
          let editable = role == 'leader'
            ? ['title', 'order', 'status', 'deadline', 'latestVersion', 'updatedAt', 'updatedBy']
            : role == 'member'
              ? ['status', 'latestVersion', 'updatedAt', 'updatedBy']
              : ['status', 'updatedAt', 'updatedBy'];
          return validChapter(after)
            && changed.hasOnly(editable)
            && after.updatedAt == request.time
            && after.updatedBy == request.auth.uid
            && (after.status == before.status
              || role != 'member'
              || (before.status != 'approved' && after.status != 'approved'))
            && (!changed.hasAny(['latestVersion'])
              || (after.latestVersion == before.latestVersion + 1
                && existsAfter(/databases/$(database)/documents/groups/$(groupId)/chapters/$(chapterId)/versions/$(string(after.latestVersion)))));
        }

        // One document per uploaded draft; its id is the version number.
        match /versions/{versionId} {
          allow read: if isMember(groupId);
          allow create: if isMember(groupId)
            && roleIn(groupId) != 'adviser'
            && request.resource.data.keys().hasOnly([
                'groupId', 'chapterId', 'versionNumber', 'fileId', 'note', 'uploadedBy', 'uploadedAt'])
            && request.resource.data.groupId == groupId
            && request.resource.data.chapterId == chapterId
            && request.resource.data.versionNumber is int
            && versionId == string(request.resource.data.versionNumber)
            && getAfter(/databases/$(database)/documents/groups/$(groupId)/chapters/$(chapterId)).data.latestVersion
                == request.resource.data.versionNumber
            && existsAfter(/databases/$(database)/documents/groups/$(groupId)/files/$(request.resource.data.fileId))
            && isText(request.resource.data.note, 0, 500)
            && request.resource.data.uploadedBy == request.auth.uid
            && request.resource.data.uploadedAt == request.time;
          // History is permanent; only the Admin SDK removes it, with its chapter.
          allow update, delete: if false;
        }
      }

      // ---------------------------------------------------------------- tasks

      // Leaders create, edit, assign and delete tasks. Members may only move a
      // task they're assigned to (status and completion). Same table as TaskRules.kt.
      match /tasks/{taskId} {
        allow read: if isMember(groupId);
        allow create: if isLeader(groupId) && validNewTask();
        allow update: if isMember(groupId) && validTaskUpdate(roleIn(groupId));
        // Comments and attachments of a deleted task are removed by cleanUpTask.
        allow delete: if isLeader(groupId);

        function validTaskFields(data) {
          return isText(data.title, 1, 100)
            && isText(data.description, 0, 1000)
            && data.priority in ['low', 'medium', 'high']
            && data.status in ['todo', 'in_progress', 'done']
            && isOptionalTimestamp(data.dueAt)
            && isOptionalText(data.chapterId, 128)
            && data.assigneeIds is list
            && data.assigneeIds.size() <= 10
            && get(groupPath(groupId)).data.memberIds.hasAll(data.assigneeIds)
            // A task counts as completed exactly when it's in the Done column.
            && (data.status == 'done') == (data.completedAt != null)
            && (data.status == 'done') == (data.completedBy != null);
        }

        function validNewTask() {
          let data = request.resource.data;
          return data.keys().hasOnly([
              'groupId', 'title', 'description', 'priority', 'status', 'dueAt', 'chapterId',
              'assigneeIds', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'completedAt', 'completedBy'])
            && validTaskFields(data)
            && data.groupId == groupId
            && data.status == 'todo'
            && data.createdBy == request.auth.uid
            && data.createdAt == request.time
            && data.updatedAt == request.time
            && data.updatedBy == request.auth.uid;
        }

        function validTaskUpdate(role) {
          let before = resource.data;
          let after = request.resource.data;
          let changed = after.diff(before).affectedKeys();
          let completing = changed.hasAny(['completedAt'])
            ? (after.completedAt == null || (after.completedAt == request.time && after.completedBy == request.auth.uid))
            : true;
          let leaderEdit = role == 'leader'
            && changed.hasOnly([
                'title', 'description', 'priority', 'status', 'dueAt', 'chapterId', 'assigneeIds',
                'updatedAt', 'updatedBy', 'completedAt', 'completedBy']);
          let assigneeMove = role == 'member'
            && request.auth.uid in before.assigneeIds
            && changed.hasOnly(['status', 'updatedAt', 'updatedBy', 'completedAt', 'completedBy']);
          return validTaskFields(after)
            && after.updatedAt == request.time
            && after.updatedBy == request.auth.uid
            && completing
            && (leaderEdit || assigneeMove);
        }

        // Discussion on a task: anyone in the group, the adviser included.
        match /comments/{commentId} {
          allow read: if isMember(groupId);
          allow create: if isMember(groupId)
            && request.resource.data.keys().hasOnly([
                'groupId', 'taskId', 'body', 'authorId', 'authorName', 'createdAt'])
            && request.resource.data.groupId == groupId
            && request.resource.data.taskId == taskId
            && isText(request.resource.data.body, 1, 1000)
            && isText(request.resource.data.authorName, 0, 50)
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          // Authors can take back what they wrote; leaders can moderate.
          allow delete: if isMember(groupId)
            && (resource.data.authorId == request.auth.uid || isLeader(groupId));
        }
      }

      // ---------------------------------------------------------------- files

      // One record per file in Storage. Students upload drafts and task
      // attachments; advisers upload only files that go with their feedback.
      match /files/{fileId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId) && validNewFile(roleIn(groupId));
        allow update: if false;
        // Drafts are version history and stay; other files can be removed by
        // whoever uploaded them, or by a leader.
        allow delete: if isMember(groupId)
          && resource.data.kind != 'draft'
          && (resource.data.uploadedBy == request.auth.uid || isLeader(groupId));

        function validNewFile(role) {
          let data = request.resource.data;
          return data.keys().hasOnly([
              'name', 'mimeType', 'sizeBytes', 'storagePath', 'kind', 'chapterId',
              'taskId', 'feedbackId', 'uploadedBy', 'uploadedAt'])
            && isText(data.name, 1, 100)
            && data.mimeType is string
            && (data.mimeType in ['application/pdf',
                  'application/vnd.openxmlformats-officedocument.wordprocessingml.document']
                || data.mimeType.matches('image/.*'))
            && data.sizeBytes is int && data.sizeBytes > 0 && data.sizeBytes <= 20 * 1024 * 1024
            && data.storagePath == 'groups/' + groupId + '/files/' + fileId + '/' + data.name
            && data.kind in ['draft', 'attachment', 'feedback']
            && (role == 'adviser') == (data.kind == 'feedback')
            && (data.kind != 'draft'
              || exists(/databases/$(database)/documents/groups/$(groupId)/chapters/$(data.chapterId)))
            && (data.kind != 'attachment'
              || exists(/databases/$(database)/documents/groups/$(groupId)/tasks/$(data.taskId)))
            && data.uploadedBy == request.auth.uid
            && data.uploadedAt == request.time;
        }
      }

      // Current invite codes, shown on the leader's screen. Written by createInvite.
      match /invites/{role} {
        allow read: if isLeader(groupId);
        allow write: if false;
      }
    }

    // The collection-group query that syncs every chapter's versions at once.
    // It must filter on groupId, which lets this rule check membership.
    match /{path=**}/versions/{versionId} {
      allow read: if isMember(resource.data.groupId);
    }

    // The collection-group query that syncs every task's comments at once.
    match /{path=**}/comments/{commentId} {
      allow read: if isMember(resource.data.groupId);
    }

    // Code lookup table. Only the Cloud Functions read or write it, so codes
    // can't be listed or guessed through the client SDK.
    match /inviteCodes/{code} {
      allow read, write: if false;
    }
  }
}
